# Valeurs chargées par `nuxt build --dotenv e2e/e2e.env` pour le build E2E :
# rien ne doit venir du `.env` du développeur. Aucune donnée sensible ici.
DATABASE_URL=postgresql://postgres@localhost:5432/focus_e2e
REDIS_URL=redis://localhost:6379/15
ADMIN_EMAIL=e2e-admin@focus.test
ADMIN_PASSWORD=
APP_URL=http://localhost:3100
